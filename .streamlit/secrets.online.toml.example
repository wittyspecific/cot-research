# ONLINE / STREAMLIT DEPLOYMENT
# Add these values in the hosting platform's Secrets UI.
# Do NOT add MT5 login/password, a local db_path, or any local file path here.

[deployment]
mode = "REMOTE_GATEWAY"

[gateway]
base_url = "https://YOUR-HTTPS-GATEWAY-HOST"
shared_key = "SAME_LONG_RANDOM_SECRET_AS_ON_THE_MAC"
timeout_seconds = 15
verify_tls = true

# Optional UI default for requested risk. No FTMO account/risk snapshot is exposed online.
[risk]
initial_capital = 100000
target_trade_risk_pct = 0.0025
