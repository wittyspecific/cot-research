# LOCAL / MASTER MAC
# Copy locally to .streamlit/secrets.toml.
# NEVER commit the real file.

[deployment]
mode = "LOCAL"

[mt5]
mode = "bridge"  # macOS: bridge | Windows: auto/python
login = 123456789
password = "INVESTOR_PASSWORD_OR_READONLY_PASSWORD"
server = "YOUR_MT5_SERVER"
timeout_ms = 10000

# macOS: Terminal\\Common\\Files path used by MT5ReadOnlyBridge.mq5.
bridge_common_path = ""
bridge_max_age_seconds = 15

# Internal safety policy. These values are NOT broker rules.
[risk]
initial_capital = 100000
target_trade_risk_pct = 0.0025
max_single_trade_risk_pct = 0.005
max_instrument_risk_pct = 0.005
max_open_risk_pct = 0.02
max_cluster_risk_pct = 0.0075
max_fx_factor_risk_pct = 0.0075
daily_safety_reserve_pct = 0.02
total_safety_reserve_pct = 0.04
weekend_stress_multiplier = 2.00

# Leave empty to use the persistent user-level default path.
[journal]
db_path = ""

# Secret shared only between the online Streamlit server and the local gateway.
# Generate a long random value, e.g. with:
# python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
[gateway]
shared_key = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
session_hours = 12
